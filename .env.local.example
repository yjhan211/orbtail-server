# 개발자 PC (로컬 Docker) 환경 변수 템플릿.
# 사용법:
#   cp .env.local.example .env.local
#   ./dev.sh start
#
# docker-compose.local.yml은 대부분 hardcode 값을 사용하므로
# 이 파일은 "필요할 때만" 참조한다 (예: GAME_SERVER_IP 오버라이드).

# 클라이언트가 GameServer에 접속할 때 사용할 IP/포트.
# UserServer가 Matching 성공 시 클라이언트에 알려주는 값.
# 로컬에서는 127.0.0.1 사용.
GAME_SERVER_IP=127.0.0.1
GAME_SERVER_PORT=9001

# 로깅
LOG_LEVEL=Debug
